{
  "slug": "product-walkthrough",
  "type": "product",
  "env": {
    "base": "https://dkn291e7rr9st.cloudfront.net",
    "tenant": "demo@carlog.app",
    "login": {
      "route": "/login",
      "userSelector": "input[type=\"email\"]",
      "passSelector": "input[type=\"password\"]",
      "submitSelector": "button[type=\"submit\"]"
    }
  },
  "voice": { "provider": "elevenlabs", "voiceId": "EXAVITQu4vr4xnSDxMaL", "name": "Sarah" },
  "resources": {},
  "segments": [
    {
      "id": "01-garage",
      "shots": [
        { "cue": "This is your garage", "do": "navigate", "with": { "to": "/" } },
        { "cue": "Volkswagen Golf", "do": "highlight", "with": { "field": "Volkswagen Golf", "hold": 2 } },
        { "cue": "Mazda CX-5", "do": "highlight", "with": { "field": "Mazda CX-5", "hold": 2 } }
      ]
    },
    {
      "id": "02-attention",
      "shots": [
        { "cue": "Right at the top", "do": "navigate", "with": { "to": "/" } },
        { "cue": "Needs attention strip", "do": "highlight", "with": { "field": "Needs attention", "hold": 2 } },
        { "cue": "The Golf is flagged", "do": "highlight", "with": { "field": "Golf", "hold": 2 } }
      ]
    },
    {
      "id": "03-vehicle",
      "shots": [
        { "cue": "the whole car lives on one page", "do": "navigate", "with": { "to": "/cars/06e39403-6bd3-4a00-bd57-1c0272ff715b" } },
        { "cue": "the odometer at 128,400 mi", "do": "highlight", "with": { "field": "ODOMETER", "hold": 2 } },
        { "cue": "8 records on file", "do": "highlight", "with": { "field": "RECORDS", "hold": 2 } },
        { "cue": "32,950 UAH spent", "do": "highlight", "with": { "field": "TOTAL SPENT", "hold": 2 } }
      ]
    },
    {
      "id": "04-timeline",
      "shots": [
        { "cue": "The heart of CarLog is the timeline", "do": "navigate", "with": { "to": "/cars/06e39403-6bd3-4a00-bd57-1c0272ff715b" } },
        { "cue": "an oil change in May 2024", "do": "highlight", "with": { "field": "May 18, 2024", "hold": 2 } },
        { "cue": "a spending-by-year chart", "do": "highlight", "with": { "field": "SPENDING BY YEAR", "hold": 2 } }
      ]
    },
    {
      "id": "05-event",
      "shots": [
        { "cue": "Click any record for the full detail", "do": "navigate", "with": { "to": "/cars/06e39403-6bd3-4a00-bd57-1c0272ff715b" } },
        { "cue": "This oil change opens up", "do": "click", "with": { "selector": ".MuiAccordionSummary-root:has-text(\"May 18, 2024\")" } },
        { "cue": "the work performed", "do": "wait", "with": { "seconds": 2 } }
      ]
    },
    {
      "id": "06-search",
      "shots": [
        { "cue": "Finding a record is instant", "do": "navigate", "with": { "to": "/cars/06e39403-6bd3-4a00-bd57-1c0272ff715b" } },
        { "cue": "Search by keyword", "do": "highlight", "with": { "field": "Search records", "hold": 2 } },
        { "cue": "category chip like Brakes", "do": "click", "with": { "selector": ".MuiChip-clickable:has-text(\"Brakes\")" } }
      ]
    },
    {
      "id": "07-reminders",
      "shots": [
        { "cue": "keeps you ahead of maintenance", "do": "navigate", "with": { "to": "/cars/06e39403-6bd3-4a00-bd57-1c0272ff715b?tab=reminders" } },
        { "cue": "21 days overdue", "do": "highlight", "with": { "field": "21 days overdue", "hold": 2 } },
        { "cue": "due in 20 days", "do": "highlight", "with": { "field": "in 20 days", "hold": 2 } }
      ]
    },
    {
      "id": "08-add-profile",
      "shots": [
        { "cue": "Adding a record is just as easy", "do": "navigate", "with": { "to": "/cars/06e39403-6bd3-4a00-bd57-1c0272ff715b" } },
        { "cue": "tap the plus button", "do": "click", "with": { "selector": "button[aria-label=\"Add\"]" } },
        { "cue": "enter it manually", "do": "highlight", "with": { "field": "Enter manually", "hold": 2 } },
        { "cue": "in your profile", "do": "navigate", "with": { "to": "/profile" } },
        { "cue": "light and dark themes", "do": "highlight", "with": { "field": "Dark", "hold": 2 } },
        { "cue": "English and Ukrainian", "do": "highlight", "with": { "field": "Ukrainian", "hold": 2 } }
      ]
    }
  ]
}